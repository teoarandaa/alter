# Copia este archivo como .env.local
# URL del backend (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL pública de la web (para SEO: sitemap, metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analítica con Umami (https://umami.is). Vacío = no se mide nada (lo normal en local).
# Al publicar: crea la web en Umami y pega aquí su «Website ID».
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Solo cambia si alojas Umami tú mismo
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Dominio(s) donde medir, separados por comas (p. ej. alter.es). Vacío = cualquiera.
NEXT_PUBLIC_UMAMI_DOMAINS=
