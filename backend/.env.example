# Copia este archivo como .env y rellena tus claves.

# Clave de la API de Claude (https://console.anthropic.com). Sin ella, Alter usa heurísticas simples.
ANTHROPIC_API_KEY=
# Modelo de Claude
CLAUDE_MODEL=claude-haiku-5-5

# Token de Apify (https://console.apify.com/settings/integrations). Sin él, Alter funciona en modo demo.
APIFY_TOKEN=
# Fuerza el modo demo aunque haya token (1 = sí)
ALTER_DEMO_MODE=0
# Segundos máximos que se espera a cada actor de Apify
ALTER_APIFY_TIMEOUT=120
# Scrapers de Apify ejecutándose a la vez. El plan gratuito admite 5 (y 16 GB de memoria en total).
ALTER_APIFY_MAX_CONCURRENCY=4

# Orígenes que pueden llamar a la API (separados por comas)
ALTER_ALLOWED_ORIGINS=http://localhost:3000

# --- Panel privado de gastos (/admin) ---
# Contraseña del panel. Vacía = panel desactivado. Usa una larga y aleatoria.
ALTER_ADMIN_TOKEN=
# Clave de administración de Anthropic (sk-ant-admin...), solo para leer el gasto en Claude.
# Se crea en console.anthropic.com > Settings > Admin keys. No es la ANTHROPIC_API_KEY.
ANTHROPIC_ADMIN_KEY=
